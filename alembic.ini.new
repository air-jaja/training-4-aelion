[alembic]
script_location = modules/database/migrations
#sqlalchemy.url = postgresql+psycopg2://indusense_user:ThEP@ssW0rd@localhost:5432/indusense_db
#sqlalchemy.url = postgresql+psycopg2://%(DB_USER)s:%(DB_PASSWORD)s@%(DB_HOST)s:%(DB_PORT)s/%(DB_NAME)s

# Additional configuration for Alembic
prepend_sys_path = .
version_path_separator = os
sqlalchemy.url = %(sqlalchemy.url)s

[post_write_hooks]
[post_write_hooks.hooks]
[post_write_hooks.lint]

[loggers]
keys = root,sqlalchemy,alembic
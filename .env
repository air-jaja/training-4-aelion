## Environment variables for:
## ---- PostgreSQL ----

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
## PostgreSQL Database name (default db)
DB_NAME=indusense_db
## PostgreSQL Database user (default duser)
DB_USER=indusense_user
## PostgreSQL Server password (default dbpassword)
DB_PASSWORD=ThEPssW0rd      # OLD = ThEP@ssW0rd 



# Input/Output Directories
INPUT_DATA_DIR="./artifacts/ingestions/datas"
OUTPUT_DIR="./artifacts/ingestions"
ANONYMIZE_COLUMNS="operator_name|operator_badge"
